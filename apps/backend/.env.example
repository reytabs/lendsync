BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=LendSync
# Or use a single From string instead of EMAIL/NAME:
# BREVO_FROM=LendSync <noreply@yourdomain.com>
# Sender email must be verified in Brevo (Senders, Domains & Dedicated IPs)
